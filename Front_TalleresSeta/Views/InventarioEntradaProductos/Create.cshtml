@model Front_TalleresSeta.Modelos.InventarioEntradaProducto
<link rel="stylesheet" href="~/css/CodigoDeBarras/style.css">
<audio id="beep" src="~/audio/CodigoDeBarras/beep.mp3"></audio>


@{
	ViewData["Title"] = "Create";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var TipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var TipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
	@if (ViewBag.accion == "CREADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "FALLO")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "CREADO_CON_ERROR")
	{
		<div id="alert-message" class="alert alert-warning" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>


<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Registrar Producto
						</span>
					</div>
				</div>
				<div class="text-right col-sm-8">
					<div class="form-group">
						<span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">
			<form class="needs-validation" novalidate asp-controller="InventarioEntradaProductos" asp-action="Create">
				<div class="row">
					<div class="col-lg-4 col-md-4">
						<div class="row">
							<div class="col-lg-12 col-md-12">
								<div class="form-group">
									<label for="validarCodigo" class="col-sm-12 col-form-label">
										CÓDIGO PRODUCTO<b style="color:red;"> *</b>
										<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un código"></i>
									</label>
									<div class="col-sm-12">
										<input type="text" class="form-control text-center" id="validarCodigo" asp-for="CodigoProducto" required>
										<div class="valid-tooltip">
											OK!
										</div>
										<div class="invalid-tooltip">
											código incorrecto
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="row">							
							<div class="col-lg-6 col-md-6">
								<button class="btn btn-primary w-100 d-flex align-items-center justify-content-center" id="btnCapturar">
									<img src="~/images/Admin_Productos/codigo-de-barras.png" style="width:15%; margin-right: 5px;" /> Capturar Código
								</button>
								<div id="CancelarEscaneo" style="width: 100%; max-width: 600px; display: none;">
									<button class="btn btn-danger w-100 d-flex align-items-center justify-content-center" id="btnCancelarEscaneo">
										<img src="~/images/Admin_Productos/escaneo-de-codigo-de-barras.png" style="width:15%; margin-right: 5px;" /> Cancelar Escaneo
									</button>
								</div>
							</div>
							<div class="col-lg-6 col-md-6">
								<button class="btn btn-success w-100 d-flex align-items-center justify-content-center" id="btnGenerar">
									<img src="~/images/Admin_Productos/escaneo-de-codigo-de-barras (1).png" style="width:15%; margin-right: 5px;" /> Generar Código
								</button>
							</div>
						</div>
					</div>

					<div class="col-lg-8 col-md-8">
						<div class="row">
							<div class="row justify-content-center align-items-center">
								<div class="col-lg-6 col-sm-8 text-center">
									<div class="d-flex justify-content-center align-items-center">
										<div id="contenedor" style="width: 100%; max-width: 600px; display: none;">
											<video id="video" autoplay playsinline style="width: 100%; height: auto; border-radius: 8px;"></video>
											<div id="marcoEscaneo"></div>
										</div>
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-6">
								<div class="form-group">
									<div class="text-center mt-3">
										<a class="d-block" id="btnDescargar" style="display: none;">
											<div class="d-flex justify-content-center align-items-center">
												<input type="hidden" asp-for="ImagenCodigoDeBarras" />
												<input type="hidden" asp-for="ConsecutivoCodBarras" id="consecutivoCodBarras" />
												<canvas id="barcodeCanvas" style="max-width: auto; height: 50%; display: none;"></canvas>
												<img id="barcodeImage" style="display: none; margin-right: 7px; max-width: auto; height: 50%;" />
											</div> <span>Descargar</span>
										</a>
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-6 text-center">
								<label for="ImagenProducto" class="col-sm-12 text-center">
									PRODUCTO
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Sube una imagen del producto"></i>
								</label>
								<div class="d-flex justify-content-center align-items-center">
									<div class="row">
										<div class="col-lg-12 col-sm-12">
											<div class="col-sm-12 text-center">
												<input type="hidden" asp-for="ImagenProducto" id="ImagenProducto" />
												<img class="form-control" src="#" id="previewImagenProducto" alt="Vista previa de la imagen"
													 style="max-width: 200px; height: 200px; border: 2px solid #ddd; padding: 5px; border-radius: 10px; margin-top: 0px; margin-left: auto; margin-right: auto; display: none;" />
												<img class="form-control" src="~/images/Admin_Productos/SinArchivos.png" id="iconoPreviewImagenProducto" alt="Imagen del producto" style="max-width: 100px; height: 100px; border: 2px solid #ddd; padding: 5px; border-radius: 10px; margin-top: 0px; margin-left: auto; margin-right: auto; display: block;" />
												<input type="file" id="inputImagenProducto" class="form-control" accept="image/*" style="max-width: 100%; height: auto; margin-top: 20px;" />
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<hr class="my-4" />

				<div class="row">
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="validarInventarioProveedorId" class="col-sm-12 col-form-label">
								PROVEEDOR<b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un proveedor"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker form-control" data-live-search="true" id="validarInventarioProveedorId"
										asp-for="InventarioProveedorId" asp-items="ViewBag.InventarioProveedorId" required>
									<option value="">Seleccionar...</option>
								</select>
								<span asp-validation-for="InventarioProveedorId" class="text-danger"></span>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona algún proveedor.
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="validarInventarioMarcaId" class="col-sm-12 col-form-label">
								MARCA<b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una marca"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker form-control" data-live-search="true" id="validarInventarioMarcaId"
										asp-for="InventarioMarcaId" asp-items="ViewBag.InventarioMarcaId" required>
									<option value="">Seleccionar...</option>
								</select>
								<span asp-validation-for="InventarioMarcaId" class="text-danger"></span>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona una marca.
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="idCategoria" class="col-sm-12 col-form-label">
								CATEGORIA<b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una categoria"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker form-control" data-live-search="true" id="idCategoria" name="idCategoria"
										asp-items="ViewBag.InventarioCategoriaId" required>
									<option value="">Seleccionar...</option>
								</select>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona una categoria.
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="validarInventarioSubCategoriaId" class="col-sm-12 col-form-label">
								SUB-CATEGORIA<b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una sub-categoria"></i>
							</label>
							<div class="col-sm-12">
								<select class="form-control" id="validarInventarioSubCategoriaId"
										asp-for="InventarioSubCategoriaId" asp-items="ViewBag.InventarioSubCategoriaId" required>
									<option value="">Seleccionar...</option>
								</select>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona una sub-categoria.
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="text-center col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="ActivoProducto" class="col-sm-12 col-form-label">
								ACTIVO
							</label>
							<div class="col-sm-12">
								<i class="fas fa-check-square" style="color: green;"></i>
							</div>
						</div>
					</div>
					<div class="text-center col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="validarHomologado" class="text-center col-sm-12 col-form-label">
								HOMOLOGADO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar si es homologado"></i>
							</label>
							<div class="text-center col-sm-12">
								<input type="checkbox" class="form-check-input" id="validarHomologado"
									   asp-for="Homologado">
							</div>
						</div>
					</div>
					<div class="text-center col-lg-3 col-sm-4">
						<div class="form-group">
							<label for="validarStockMinimo" class="text-center col-sm-12 col-form-label">
								STOCK MÍNIMO <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa una cantidad mínima de stock para este producto"></i>
							</label>
							<div class="text-center col-sm-8">
								<input type="number" class="form-control" id="validarStockMinimo" value="2" asp-for="StockMinimo" required>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								stock incorrecto
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarNombre" class="col-sm-12 col-form-label">
								NOMBRE PRODUCTO<b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un nombre de producto"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarNombre" asp-for="NombreProducto" required>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								nombre incorrecto
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<div class="row">
								<label for="validarReferencia" class="col-sm-12 col-form-label">
									REFERENCIA<b style="color:red;"> *</b>
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="" data-original-title="Ingresar una referencia"></i>
								</label>
								<div class="col-sm-12 col-input-group">
									<label class="col-md-3 input-group-addon">N/A </label>
									<input type="checkbox" class="col-sm-1 form-check-input" id="CheckSinCampos">
									<input type="text" class="col-sm-8 form-control" id="validarReferencia" asp-for="Referencia"
										   required style="float:right;">
								</div>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								referecia incorrecta
							</div>
						</div>
					</div>
					<div class="col-lg-2 col-sm-2">
						<div class="form-group">
							<label for="validarCantidad" class="col-sm-12 col-form-label">
								CANTIDAD <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa una cantidad"></i>
							</label>
							<div class="col-sm-12">
								<input type="number" class="form-control" id="validarCantidad" name="CantidadIngresa" value="@ViewBag.CantidadIngresa" required>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								cantidad incorrecta
							</div>
						</div>
					</div>
					<div class="col-lg-2 col-sm-2">
						<div class="form-group">
							<label for="validarColor" class="col-sm-12 col-form-label">
								COLOR
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un color"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker form-control" data-live-search="true" id="validarColor"
										asp-for="Color_cId" asp-items="ViewBag.Color_cId">
									<option value="">Seleccionar...</option>
								</select>
								<span asp-validation-for="Color_cId" class="text-danger"></span>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								color incorrecto
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-6 col-sm-6">
						<div class="form-group">
							<label for="validarVehiculoAsociado" class="col-sm-12 col-form-label">
								VEHÍCULOS ASOCIADOS
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Se debe ingresar cada vehículo de la siguiente forma: Vehículo/Modelo/Año"></i>
							</label>
							<div class="col-sm-12">
								<textarea type="text" class="form-control" id="validarVehiculoAsociado" asp-for="VehiculoAsociado" placeholder="Marca/Modelo/Año" rows="6" style="width: 100%; resize: both;"> </textarea>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Vehiculo Asociado incorrecto
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarPosicionProducto" class="col-sm-12 col-form-label">
								POSICIÓN PRODUCTO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una posición del producto en el vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarPosicionProducto" asp-for="PosicionProducto">
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Posición del producto incorrecta
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarUbicacionProducto" class="col-sm-12 col-form-label">
								UBICACIÓN STAND PRODUCTO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una ubicación para el producto en el estand"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarUbicacionProducto" asp-for="UbicacionProducto">
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Ubicación del Producto incorrecta
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarPrecioC" class="col-sm-12 col-form-label">
								PRECIO COMPRA <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un precio de compra por unidad"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarPrecioC" name="PrecioCompraPorUni" value="@ViewBag.PrecioCompraPorUni"
									   oninput="formatoMoneda(this, 'resPrecioC')" required>
								<p id="resPrecioC"></p>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								precio compra incorrecto
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarPrecioV" class="col-sm-12 col-form-label">
								PRECIO VENTA <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un precio de venta por unidad"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarPrecioV" name="PrecioVentaPorUni" value="@ViewBag.PrecioVentaPorUni"
									   oninput="formatoMoneda(this, 'resPrecioV')" required>
								<p id="resPrecioV"></p>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								precio venta incorrecto
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label class="col-sm-12 col-form-label">
								MEDIDA
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una Medida"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker form-control" data-live-search="true" id="idMedida_c" name="idMedida_c"
										asp-items="ViewBag.Medida_cId">
									<option value="">Seleccionar...</option>
								</select>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label class="col-sm-12 col-form-label">
								UNIDAD DE MEDIDA
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una unidad de medida"></i>
							</label>
							<div class="col-sm-12">
								<select class="form-control" id="validarUnidadMedida"
										asp-for="UnidadMedida_cId" asp-items="ViewBag.UnidadMedida_cId">
									<option value="">Seleccionar...</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							@if (TipoUser == "SuperAdmin")
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller<b style="color:red;"> *</b>
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							else
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona algún Taller.
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-8 col-sm-4">
						<div class="form-group">
							<label for="validarDetalle" class="col-sm-12 col-form-label">
								DETALLE
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="No mayor a 200 caracteres"></i>
							</label>
							<div class="col-sm-12">
								<textarea type="text" class="form-control" id="validarDetalle" asp-for="Detalle"
										  rows="6" style="width: 100%; resize: both;"></textarea>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								detalle superó los 200 caracteres
							</div>
						</div>
					</div>
				</div>

				<hr />
				<div class="row">
					<!-- Botón atrás -->
					<div class="col-sm-6">
						<div class="form-group">
							<a asp-controller="InventarioEntradaProductos" asp-action="Index" class="btn btn-dark btn-regresar">Atrás </a>
						</div>
					</div>
					<!-- Botón registrar -->
					<div class="col-sm-6">
						<div class="form-group">
							<input type="submit" value="Registrar" class="btn btn-success btn-registrar" />
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>


