@model IEnumerable<Front_TalleresSeta.Modelos.ModelosView.ViewInventarioLote>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var TipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var TipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
	<!-- Tabla de datos -->
	<div class="card shadow mb-4">
		<div class="card-header py-3">
			<div class="row">
				<!-- Link consolidado -->
				<div class="col-sm-4">
					<div class="form-group">
						<a asp-controller="Interfaz" asp-action="MuyPronto" asp-route-id="" class="nav-link">
							<span>
								<i class="fab fa-wpforms"></i>
								Informe Stocks
							</span>
						</a>
					</div>
				</div>				
			</div>
		</div>

		<div class="card-body">

			<!-- Filtro por año -->
			<div class="row">
				<div class="col-lg-3">
					<form asp-controller="InventarioStocks" asp-action="Index">
						<div class="input-group mb-3">
							<select step="1" name="search" class="form-control" aria-label="Buscar" aria-describedby="button-filtrar" asp-items="ViewBag.FechaRegistro">
							</select>
							<div class="input-group-append">
								<input class="btn btn-primary btn-user center-block" type="submit" id="button-filtrar" value="Filtrar por año">
							</div>
						</div>
					</form>
				</div>
			</div>


			<div class="table-responsive">
				<table id="modelTable" class="table table-hover table-outline mb-0">
					<thead class="thead-light" align="center">
						<tr>
							<th>
								OK
							</th>
							<th>
								CODIGO
							</th>
							<th>
								PRODUCTO
							</th>
							<th>
								INGRESADOS
							</th>
							<th>
								STOCK
							</th>
							<th>
								VENDIDOS
							</th>
						</tr>
					</thead>
					<tbody class="text-center">
						@foreach (var item in Model)
						{
							<tr>
								<td class="text-center">
									@{
										if (item.Habilitado == true)
										{
											<span><i class="fas fa-check-square" style="color: green;"></i></span>
										}
										else
										{
											<span><i class="far fa-window-close" style="color: firebrick;"></i></span>
										}
									}
								</td>
								<td>
									@Html.DisplayFor(modelItem => item.CodigoProducto)
								</td>
								<td>
									@Html.DisplayFor(modelItem => item.NombreProducto)
								</td>
								<td>
									@Html.DisplayFor(modelItem => item.TotalIngresados)
								</td>
								<td>
									@Html.DisplayFor(modelItem => item.CantStock)
								</td>
								<td>
									@Html.DisplayFor(modelItem => item.CantVendidos)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>


@section Scripts {
	<script src="~/lib/data-tables/datatables.min.js"></script>
	<script>
		$(document).ready(function () {
			$('#modelTable').DataTable({
				order: [],
				language: {
					url: '/lib/data-tables/Spanish.json'
				}
			});
		});

		// Ocultar el mensaje después de 30 segundos
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

	</script>

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}