@model Front_TalleresSeta.Modelos.ModelosView.ViewVentaProducto
<link rel="stylesheet" href="~/css/CodigoDeBarras/style.css">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">


<audio id="beep" src="~/audio/CodigoDeBarras/beep.mp3"></audio>


@{
    ViewData["Title"] = "Vender Producto";
    Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

    var TipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
    var TipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
    @if (ViewBag.accion == "CREADO")
    {
        <div id="alert-message" class="alert alert-success" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "FALLO")
    {
        <div id="alert-message" class="alert alert-danger" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "CREADO_CON_ERROR")
    {
        <div id="alert-message" class="alert alert-warning" role="alert">
            @ViewBag.mensaje
        </div>
    }
</div>


<style>
    body {
        background-color: #f4f7f6;
        padding-bottom: 100px; /* Espacio para que el botón fijo no tape el contenido final */
    }

    .hidden-field {
        display: none !important;
    }

    .payment-card {
        border-left: 4px solid #198754;
        transition: all 0.2s ease-in-out;
    }

        .payment-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
        }

    .section-header {
        border-bottom: 2px solid #eee;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    /* ESTILOS PARA EL BOTÓN FIJO */
    .sticky-btn-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1050; /* Por encima de otros elementos */
    }

    .btn-register-sale {
        border-radius: 50px; /* Estilo redondeado moderno */
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .btn-register-sale:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(25, 135, 84, 0.4) !important;
        }
</style>


<div class="container-fluid">
    <div class="card shadow mb-lg-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <span class="nav-link">
                            <i class="fab fa-wpforms"></i>
                            Registrar Producto
                        </span>
                    </div>
                </div>
                <div class="text-right col-sm-8">
                    <div class="form-group">
                        <span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            @* EL FORMULARIO PRINCIPAL AHORA CONTIENE TODA LA LÓGICA DE PRODUCTO Y PAGOS *@
            <form class="needs-validation" novalidate asp-controller="InventarioSalidaProductos" asp-action="Create" method="post">

                <input type="hidden" asp-for="NombreProducto" id="cargarNombreProducto" />
                <input type="hidden" asp-for="UnidadesStock" id="cargarUnidadesStock" />
                <input type="hidden" asp-for="TallerId" id="cargarTallerId" />

                <!-- Contenedor principal: Oculto por defecto (d-none) por seguridad de interfaz -->
                <div id="contenedorDetallesProducto" class="row mb-4 p-3 bg-light rounded border d-none" aria-hidden="true">
                                        
                    <div class="col-md-3 border-end">
                        <!-- Fila para MARCA -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="fw-bold text-dark">MARCA: </label>
                            <label class="text-muted fw-bold text-uppercase" id="lblMarcaProducto"></label>
                        </div>
                        <hr class="my-4 text-secondary opacity-25">
                        <!-- Fila para PRODUCTO -->
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-bold text-dark">PRODUCTO: </label>
                            <label class="text-muted fw-bold text-uppercase" id="lblNombreProducto"></label>
                        </div>
                    </div>

                    <div class="col-md-3 border-end">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="fw-bold text-dark">REFERENCIA: </label>
                            <label class="text-muted fw-bold text-uppercase" id="lblReferenciaProducto"></label>
                        </div>
                        <hr class="my-4 text-secondary opacity-25">
                        <!-- Fila para PRODUCTO -->
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-bold text-dark">COLOR: </label>
                            <label class="text-muted fw-bold text-uppercase" id="lblColorProducto"></label>
                        </div>
                    </div>


                    <!-- SELECCIÓN DE LOTES -->
                    <div class="col-md-6">
                        <div class="d-flex flex-column">
                            <small class="text-muted fw-bold text-uppercase mb-1">Lotes Disponibles (Seleccione uno o varios)</small>

                            <!-- Contenedor dinámico de Lotes -->
                            <div id="contenedorLotes" class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="text-muted fst-italic fs-7">Cargue un producto para ver los lotes...</span>
                            </div>

                            <!-- Resumen dinámico de la selección -->
                            <div id="resumenSeleccionLotes" class="mt-2 text-primary fw-bold text-start fs-7"></div>
                        </div>
                    </div>

                </div>

                <div class="row align-items-start mb-4">
                    <div class="col-lg-4 col-md-5">
                        <div class="mb-3">
                            <label for="validarCodigo" class="form-label fw-bold">
                                CÓDIGO PRODUCTO<b class="text-danger"> *</b>
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un código"></i>
                            </label>
                            <input type="text" class="form-control" id="validarCodigo" asp-for="CodigoProducto" required>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center" id="btnCapturar">
                                <img src="~/images/Admin_Productos/codigo-de-barras.png" style="width:20px; margin-right: 8px;" /> Capturar Código
                            </button>

                            <div id="CancelarEscaneo" style="display: none;">
                                <button type="button" class="btn btn-danger w-100 d-flex align-items-center justify-content-center" id="btnCancelarEscaneo">
                                    <img src="~/images/Admin_Productos/escaneo-de-codigo-de-barras.png" style="width:20px; margin-right: 8px;" /> Cancelar Escaneo
                                </button>
                            </div>
                        </div>

                        <div id="contenedor" class="mt-2 text-center" style="display: none;">
                            <video id="video" autoplay playsinline class="img-fluid border rounded shadow-sm"></video>
                            <div id="marcoEscaneo"></div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-2 text-center">
                        @* <label class="d-block mb-2 fw-bold" id="lblCargarNombreProducto" name="lblCargarNombreProducto"></label> *@
                        <div class="position-relative d-inline-block">
                            <input type="hidden" asp-for="ImagenProducto" id="ImagenProducto" />
                            <img src="#" id="previewImagenProducto" class="img-thumbnail shadow-sm"
                                 style="width: 150px; height: 150px; object-fit: cover; display: none;" />
                            <img src="~/images/Admin_Productos/SinArchivos.png" id="iconoPreviewImagenProducto"
                                 class="img-thumbnail shadow-sm" style="width: 120px; height: 120px; opacity: 0.6;" />
                        </div>
                        <div class="mt-2 small text-muted">
                            <label class="d-block mb-2 fw-bold" id="lblCantStockActual" name="lblCantStockActual"></label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-5">
                        <div class="row align-items-center">
                            <label for="validarCantidadVendidos" class="col-sm-5 col-form-label text-end fw-bold">
                                UNIDADES A VENDER:<b class="text-danger"> *</b>
                            </label>
                            <div class="col-sm-7">
                                <input type="number" class="form-control form-control-lg border-primary" id="validarCantidadVendidos" asp-for="CantVendidos" min="1" required>
                                <span asp-validation-for="CantVendidos" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row mb-4">
                    <div class="col-md-6 border-end">
                        <div class="row align-items-center">
                            <label for="validarPrecioVentaPorUni" class="col-sm-4 col-form-label text-end fw-bold">VALOR UNIDAD</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">COP</span>
                                    <input type="text" class="form-control fw-bold" id="validarPrecioVentaPorUni" asp-for="PrecioVentaPorUni" required>
                                </div>
                                <div id="resPrecioVentaPorUni" class="form-text font-monospace text-end"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row align-items-center">
                            <label for="validarPrecioVentaTotal" class="col-sm-4 col-form-label text-end fw-bold">VALOR TOTAL VENTA</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">COP</span>
                                    <input type="text" class="form-control fw-bold" id="validarPrecioVentaTotal" asp-for="PrecioVentaTotal" required readonly>
                                </div>
                                <div id="resPrecioVentaTotal" class="form-text text-primary fw-bold text-end"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                @* INICIA LA SECCIÓN DE PAGOS INTEGRADA EN EL FORMULARIO PRINCIPAL *@
                <div class="container mt-4">
                    <h4>Detalle del pago</h4>
                    <div class="col-md-6 ms-auto">
                        <div class="row align-items-center justify-content-end">
                            <label for="validarPrecioTotalPagado" class="col-sm-6 col-form-label text-end fw-bold">VALOR TOTAL PAGADO</label>
                            <div class="col-sm-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">COP</span>
                                    <input type="text" class="form-control fw-bold" id="validarPrecioTotalPagado" asp-for="PrecioTotalPagado" required readonly>
                                </div>
                                <div id="resPrecioTotalPagado" class="form-text text-primary fw-bold text-end"></div>
                            </div>

                            <label for="validarPrecioRestantePorPagar" class="col-sm-6 col-form-label text-end fw-bold">VALOR RESTANTE POR PAGAR</label>
                            <div class="col-sm-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">COP</span>
                                    <input type="text" class="form-control fw-bold" id="validarPrecioRestantePorPagar" required readonly>
                                </div>
                                <div id="resPrecioRestantePorPagar" class="form-text text-primary fw-bold text-end"></div>
                            </div>
                        </div>
                    </div>



                    <div class="container bg-white p-5 mt-4 rounded shadow-sm">
                        <div class="section-header d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="m-0 text-dark font-weight-bold">
                                    <i class="fas fa-wallet me-2 text-success"></i>Métodos de Pago
                                </h4>
                                <small class="text-muted">Gestione los pagos del cliente para registrar la venta</small>
                            </div>
                            <button type="button" id="addPaymentMethod" class="btn btn-success rounded-pill px-4">
                                <i class="fas fa-plus me-2"></i>Agregar Pago
                            </button>
                        </div>

                        <div id="paymentMethodsContainer">
                            <!-- Los bloques de pago aparecerán aquí -->
                        </div>

                        <div id="emptyState" class="text-center py-5 text-muted border rounded-3 bg-light">
                            <i class="fas fa-hand-holding-dollar fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">No hay métodos de pago agregados.</p>
                            <small>Presione "Agregar Pago" para definir cómo se liquidará esta cuenta.</small>
                        </div>
                    </div>

                    <!-- CONTENEDOR DEL BOTÓN FIJO -->
                    <div class="sticky-btn-container">
                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-lg border-2 border-white btn-register-sale">
                            <i class="fas fa-cash-register me-2"></i> Registrar Venta Completa
                        </button>
                    </div>

                    <!-- TEMPLATE DE MÉTODO DE PAGO -->
                    <template id="paymentMethodTemplate">
                        <div class="card mb-3 payment-card active-payment-block shadow-sm">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-uppercase">Método</label>
                                        <select class="form-select metodo-pago-select" name="Pagos[idx].MetodoId" required>
                                            <option value="">Seleccione...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3 div-banco">
                                        <label class="form-label fw-bold small text-uppercase">Banco</label>
                                        <select class="form-select banco-select" name="Pagos[idx].BancoId">
                                            <option value="">Seleccione Banco...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3 div-tipo-tarjeta">
                                        <label class="form-label fw-bold small text-uppercase">Tipo Tarjeta</label>
                                        <select class="form-select tipo-tarjeta-select" name="Pagos[idx].TipoTarjetaId">
                                            <option value="">Seleccione Tipo...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small text-uppercase">Valor</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light">COP</span>
                                            <input type="number" step="0.01" class="form-control monto-pago" name="Pagos[idx].Monto" placeholder="0.00" required>
                                        </div>
                                    </div>

                                    <div class="col-md-1 d-flex align-items-end justify-content-end">
                                        <button type="button" class="btn btn-outline-danger remove-payment-btn" title="Eliminar este pago">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>


                </div>
                <hr class="my-4" />



                <div class="row">
                    <div class="col-lg-12 col-sm-4">
                        <div class="form-group">
                            <label for="validarDetalle" class="col-sm-12 col-form-label">
                                DETALLE
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="No mayor a 3000 caracteres"></i>
                            </label>
                            <div class="col-sm-12">
                                <textarea type="text" class="form-control" id="validarDetalle" asp-for="Detalle"
                                          rows="5" cols="20" style="width: 100%; resize: both;"></textarea>
                            </div>
                            <div class="valid-tooltip">
                                OK!
                            </div>
                            <div class="invalid-tooltip">
                                detalle superó los 200 caracteres
                            </div>
                        </div>
                    </div>
                </div>




                <hr />
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <a asp-controller="InventarioSalidaProductos" asp-action="Index" class="btn btn-dark btn-regresar">Atrás </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>

    <script src="~/lib/Zxing/js/Zxing_Browser.js"></script>
    <script src="~/lib/jsBarcode/js/JsBarcode_all_min.js"></script>

    <script src="~/js/VenderProducto.js"></script>
    <script src="~/js/CodigoDeBarras/CargarCodigoDeBarras.js"></script>
    <script src="~/js/VentaDeProducto.js"></script>

    <script>
        // // These variables MUST come from your ViewBag, not hardcoded if they change!
        // var metodoDePagoOptions = @Html.Raw(Json.Serialize(ViewBag.MetodoDePagoId));
        // var bancoOptions = @Html.Raw(Json.Serialize(ViewBag.BancoId));
        // var creditoDebitoOptions = @Html.Raw(Json.Serialize(ViewBag.CreditoDebitoId));



        // Validaciones
        (function () {
            'use strict'

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')

            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        function formatoMoneda(input, resultPrecio) {
            const resultadoElement = document.getElementById(resultPrecio);

            // Obtener el valor actual del input y remover los caracteres no numéricos
            let precio = input.value.replace(/\D/g, '');
            //let amount = precio.replace(',', '.');
            let amount = parseInt(precio);

            if (!isNaN(amount)) {
                // Formatear el valor como moneda COP
                const formatoMoneda = new Intl.NumberFormat("es-CO", {
                    style: "currency",
                    currency: "COP",
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                });
                const cantidadFormateada = formatoMoneda.format(amount);
                input.value = cantidadFormateada;
            } else {
                    input.value = '';
                resultadoElement.textContent = "Por favor ingrese un valor válido.";
            }
        }

        // Ocultar el mensaje después de 30 segundos
        setTimeout(function () {
            var alertMessage = document.getElementById("alert-message");
            if (alertMessage) {
                alertMessage.style.display = "none";
            }
        }, 30000); // 30 segundos

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}