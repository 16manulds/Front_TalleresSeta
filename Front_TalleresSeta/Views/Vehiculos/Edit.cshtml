@model Front_TalleresSeta.Modelos.Vehiculo

@{
	ViewData["Title"] = "Editar";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var tipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var tipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
	@if (ViewBag.accion == "ACTUALIZAR")
	{
		<div id="alert-message" class="alert alert-info" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ACTUALIZADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ERROR_DATOS")
	{
		<div id="alert-message" class="alert alert-warning" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ERROR_CATCH")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>


<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Actualizar Vehículo
						</span>
					</div>
				</div>
				<div class="text-right col-sm-8">
					<div class="form-group">
						<span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">
			<form class="needs-validation" novalidate asp-controller="Vehiculos" asp-action="Edit">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<input type="hidden" asp-for="Placa" />

				<div class="row">
					<div class="col-lg-4 col-md-4">
						<div class="row">
							<div class="col-lg-12 col-md-12">
								<div class="form-group">
									<label for="validarPlaca" class="col-sm-12 col-form-label">
										PLACA<b style="color:red;"> *</b>
										<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una placa"></i>
									</label>
									<div class="col-sm-12">
										<input type="text" class="col-sm-6 form-control text-center" id="validarPlaca" asp-for="Placa" required readonly>										
									</div>
								</div>
							</div>
						</div>
					</div>										
				</div>
				<hr class="my-4" />

				<div class="row">
					<div class="text-center col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="ActivoVehiculo" class="col-sm-12 col-form-label">
								ACTIVO
							</label>
							<div class="text-center col-sm-12">
								<input type="checkbox" class="form-check-label" id="ActivoVehiculo" asp-for="@Model.Habilitado">
							</div>
						</div>
					</div>
					
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							<label class="col-sm-12 col-form-label">
								TIPO VEHÍCULO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un tipo de vehículo"></i>
							</label>
							<div class="col-sm-12">
								<select class="selectpicker" data-live-search="true" id="validarColor"
										asp-for="TipoVehiculoId" asp-items="ViewBag.TipoVehiculoId" required>
									<option value="">Seleccionar...</option>
								</select>
							</div>
						</div>
					</div>

					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							@if (tipoUser == "SuperAdmin")
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller<b style="color:red;"> *</b>
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							else
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona algún Taller.
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarMarca" class="col-sm-12 col-form-label">
								MARCA
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una marca del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" id="validarMarca" asp-for="Marca">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<div class="row">
								<label for="validarModelo" class="col-sm-12 col-form-label">
									MODELO
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="" data-original-title="Ingresar un Modelo del vehículo"></i>
								</label>
								<div class="col-sm-12 col-input-group">
									<input type="text" class="col-sm-12 form-control" id="validarModelo" asp-for="Modelo" style="float:right;">
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarColor" class="col-sm-12 col-form-label">
								COLOR
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un color del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Color" id="validarColor">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-3">
						<div class="form-group">
							<label for="validarKilometraje" class="col-sm-12 col-form-label">
								KILOMETRAJE
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Kilometraje del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Kilometraje" id="validarKilometraje">
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							<label for="validarCilindraje" class="col-sm-12 col-form-label">
								CILINDRAJE
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Cilindraje del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Cilindraje" id="validarCilindraje">
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							<label for="validarSerial" class="col-sm-12 col-form-label">
								SERIAL
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Serial del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Serial" id="validarSerial">
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							<label for="validarTransmision" class="col-sm-12 col-form-label">
								TRANSMISION
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Transmisión del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Transmision" id="validarTransmision">
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							<label for="validarMotor" class="col-sm-12 col-form-label">
								MOTOR
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Motor del vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="col-sm-12 form-control" asp-for="Motor" id="validarMotor">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarLlantas" class="col-form-label">
								CANTIDAD DE LLANTAS
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Llantas del vehículo"></i>
							</label>
							<div class="text-center col-lg-6">
								<input type="text" class="form-control" asp-for="Llantas" id="validarLlantas">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarPuertas" class="col-form-label">
								CANTIDAD DE PUERTAS
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un Puertas del vehículo"></i>
							</label>
							<div class="text-center col-sm-6">
								<input type="text" class="form-control" asp-for="Puertas" id="validarPuertas">
							</div>
						</div>
					</div>
				</div>

				<hr />
				<div class="row">
					<!-- Botón atrás -->
					<div class="col-sm-6">
						<div class="form-group">
							<a asp-controller="Vehiculos" asp-action="Details" asp-route-id="@Model.Placa" class="btn btn-dark btn-regresar">Atrás</a>
						</div>
					</div>
					<!-- Botón Modificar -->
					<div class="col-sm-6">
						<div class="form-group">
							<input type="submit" value="Modificar" class="btn btn-primary btn-actualizar" />
						</div>
					</div>
				</div>

			</form>
		</div>

	</div>
</div>




@section Scripts {

	<script src="~/js/CodigoDeBarras/CargarCodigoDeBarras.js"></script>


	<script>
				
		// Inicializar tooltips
		$(function () {
			$('[data-bs-toggle="tooltip"]').tooltip();
		});

		// Validaciones
		(function () {
			'use strict'

			// Fetch all the forms we want to apply custom Bootstrap validation styles to
			var forms = document.querySelectorAll('.needs-validation')

			// Loop over them and prevent submission
			Array.prototype.slice.call(forms)
				.forEach(function (form) {
					form.addEventListener('submit', function (event) {
						if (!form.checkValidity()) {
							event.preventDefault()
							event.stopPropagation()
						}
						form.classList.add('was-validated')
					}, false)
				})
		})()
		
		// Ocultar el mensaje
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

	</script>


	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}