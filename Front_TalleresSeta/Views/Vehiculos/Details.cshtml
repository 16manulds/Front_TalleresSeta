@model Front_TalleresSeta.Modelos.Vehiculo

@{
	ViewData["Title"] = "Details";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var tipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var tipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}

<div class="container-fluid">
	@if (ViewBag.accion == "CREADO" || ViewBag.accion == "ACTUALIZADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}

	@if (ViewBag.accion == "NO_ELIMINADO")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>

<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="text-left col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Detalle del vehículo
						</span>
					</div>
				</div>

				@if (tipoUser == "SuperAdmin" || tipoUser == "Admin")
				{
					<div class="text-right col-md-4">
						<div class="form-group">
							<a class="btn btn-success btn-registrar" asp-controller="RelacionUsuariosVehiculos" asp-action="VerRelacion" asp-route-id="@Model.Placa">
								Ver Usuarios <i class="fas fa-boxes fa-1x"></i>
							</a>
						</div>
					</div>
				}
			</div>
		</div>


		<div class="card-body">

			<div class="row">
				<div class="col-lg-4 col-md-4">
					<div class="row">
						<div class="col-lg-12 col-md-12">
							<div class="form-group">
								<label class="col-sm-12 col-form-label">
									PLACA
								</label>
								<div class="col-sm-12">
									<input type="text" class="form-control text-center" asp-for="Placa" readonly>
								</div>
							</div>
						</div>
					</div>
				</div>								
			</div>
			<hr class="my-4" />


			<div class="row">
				<div class="text-center col-lg-3 col-sm-4">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							ACTIVO
						</label>
						<div class="text-center col-lg-12">
							@{
								if (Model.Habilitado == true)
								{
									<i class="fas fa-check-square" style="color: green;"></i>
								}
								else
								{
									<i class="far fa-window-close" style="color: firebrick;"></i>
								}
							}
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-4">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							FECHA REGISTRO							
						</label>
						<div class="col-sm-12">
							<input type="text" class="form-control" value="@ViewBag.FechaFormateada" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-sm-12">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							TIPO VEHÍCULO
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-10 form-control" value="@ViewBag.TipoVehiculoId" readonly>
						</div>
					</div>
				</div>

				<div class="col-lg-4 col-sm-12">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							Taller
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-10 form-control" value="@ViewBag.TallerId" readonly>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-lg-3 col-sm-3">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							MARCA
						</label>
						<div class="col-sm-12">
							<input type="text" class="form-control" asp-for="Marca" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-3">
					<div class="form-group">
						<div class="row">
							<label class="col-sm-12 col-form-label">
								MODELO
							</label>
							<div class="col-sm-12 col-input-group">
								<input type="text" class="col-sm-12 form-control" asp-for="Modelo" readonly>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-3">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							COLOR
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Color" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-3">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							KILOMETRAJE
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Kilometraje" readonly>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-lg-4 col-sm-12">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							CILINDRAJE
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Cilindraje" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-sm-12">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							SERIAL
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Serial" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-sm-12">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							TRANSMISION
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Transmision" readonly>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-lg-3 col-sm-2">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							MOTOR
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-12 form-control" asp-for="Motor" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-2">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							LLANTAS
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-6 form-control" asp-for="Llantas" readonly>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-sm-4">
					<div class="form-group">
						<label class="col-sm-12 col-form-label">
							PUERTAS
						</label>
						<div class="col-sm-12">
							<input type="text" class="col-sm-6 form-control" asp-for="Puertas" readonly>
						</div>
					</div>
				</div>
			</div>
			<hr />


			<div class="row">
				<!-- Botón atrás -->
				<div class="col-sm-6">
					<div class="form-group">
						<a class="btn btn-dark btn-regresar" asp-controller="Vehiculos" asp-action="Index">
							Atrás
						</a>
					</div>
				</div>
				@if (tipoUser == "SuperAdmin" || tipoUser == "Admin" || (tipoUser == "Empleado" && tipoRol == "Jefe"))
				{
					<!-- Botón Actualizar -->
					<div class="col-sm-6">
						<div class="form-group">
							<a class="btn btn-primary btn-actualizar" asp-controller="Vehiculos" asp-action="Edit" asp-route-id="@Model.Placa">
								Actualizar
							</a>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>


@section Scripts {

	<script>

		// Ocultar el mensaje después de 30 segundos
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

	</script>

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}
