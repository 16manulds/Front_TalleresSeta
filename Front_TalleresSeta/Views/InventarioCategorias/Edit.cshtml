@model Front_TalleresSeta.Modelos.InventarioCategoria

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

    var tipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
    var tipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}

<div class="container-fluid">
    @if (ViewBag.accion == "ACTUALIZAR")
    {
        <div id="alert-message" class="alert alert-info" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ACTUALIZADO")
    {
        <div id="alert-message" class="alert alert-success" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ERROR_DATOS")
    {
        <div id="alert-message" class="alert alert-warning" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ERROR_CATCH")
    {
        <div id="alert-message" class="alert alert-danger" role="alert">
            @ViewBag.mensaje
        </div>
    }
</div>

<div class="container-fluid">
    <div class="card shadow mb-lg-4">
        <div class="card-header py-3">
            <div class="row">
                <!-- actualizar Categorias  -->
                <div class="col-md-4">
                    <div class="form-group">
                        <span class="nav-link">
                            <i class="fab fa-wpforms"></i>
                            Actualizar Categorias
                        </span>
                    </div>
                </div>
                <!-- Textocampos obligatiorios  -->
                <div class="text-right col-sm-8">
                    <div class="form-group">
                        <span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
                    </div>
                </div>
            </div>
        </div>


        <div class="card-body">
            <!-- Formulario: actualizar Categoria -->
            <form class="needs-validation" novalidate asp-controller="InventarioCategorias" asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="InventarioCategoriaId" />

                <div class="row mb-3">
                    <label for="validarDeleteCategorias" class="col-sm-3 col-form-label">
                        ACTIVO<b style="color:red;">* </b>
                        <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Indique si la Categoria se encuentra en funcionamiento"></i>
                    </label>
                    <div class="col-sm-2">
                        <input type="checkbox" class="form-check-label" id="validarDeleteCategorias" asp-for="@Model.Habilitado">
                    </div>
                    <div class="valid-tooltip">
                        OK!
                    </div>
                    <div class="invalid-tooltip">
                        campo vacío
                    </div>
                </div>
                <hr />

                <div class="row mb-3">
                    <label for="validarCategoria" class="col-sm-3 col-form-label">
                        CATEGORIA<b style="color:red;">* </b>
                        <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar sin dígito"></i>
                    </label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="validarCategoria" asp-for="NombreCategoria" required>
                    </div>
                    <div class="valid-tooltip">
                        OK!
                    </div>
                    <div class="invalid-tooltip">
                        campo vacío
                    </div>
                </div>

                <hr />
                <div class="row mb-3">
                    <label for="validarDetalleCategoria" class="col-sm-3 col-form-label">
                        DETALLE
                        <i class="far fa-question-circle" data-bs-toggle="tooltip" title="No mayor a 200 caracteres"></i>
                    </label>
                    <div class="col-sm-6">
                        <textarea type="text" class="form-control" id="validarDetalleCategoria" asp-for="Detalle"></textarea>
                    </div>
                    <div class="valid-tooltip">
                        OK!
                    </div>
                    <div class="invalid-tooltip">
                        Campo vacío
                    </div>
                </div>

                <div class="row mb-3">
                    @if (tipoUser == "SuperAdmin")
                    {
                        <label for="validarTaller" class="col-sm-3 col-form-label">
                            Taller<b style="color:red;">* </b>
                            <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
                        </label>
                        <div class="col-sm-4">
                            <select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
                        </div>
                    }
                    else
                    {
                        <label for="validarTaller" class="col-sm-3 col-form-label">
                            Taller
                        </label>
                        <div class="col-sm-4">
                            <select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
                        </div>
                    }
                    <div class="valid-tooltip">
                        OK!
                    </div>
                    <div class="invalid-tooltip">
                        Selecciona algún Taller.
                    </div>
                </div>

                <hr />
                <div class="row">
                    <!-- Botón atrás -->
                    <div class="col-sm-6">
                        <div class="form-group">
                            <a asp-controller="InventarioCategorias" asp-action="Details" asp-route-id="@Model.InventarioCategoriaId" class="btn btn-dark btn-regresar">Atrás </a>
                        </div>
                    </div>
                    <!-- Botón Modificar -->
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="submit" value="Modificar" class="btn btn-primary btn-actualizar" />
                        </div>
                    </div>
                </div>

            </form>
            <!-- Fin Formulario: registro de InventarioCategorias -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar tooltips
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        // Validaciones
        (function () {
            'use strict'

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')

            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
