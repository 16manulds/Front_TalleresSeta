@model IEnumerable<Front_TalleresSeta.Modelos.Estado>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Habilitado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreEstado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Habilitado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NombreEstado)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EstadoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EstadoId">Details</a> |
                <a asp-action="Habilitado" asp-route-id="@item.EstadoId">Habilitado</a>
            </td>
        </tr>
}
    </tbody>
</table>
