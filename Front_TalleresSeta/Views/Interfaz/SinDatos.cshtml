@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";
}


<div>
    <center>
        <img src="~/images/muy_pronto.jpg" id="img_muy_pronto" class="justify-content-center" />
        <p>
            <b>Cargue de Datos incompleto</b>
            @{
                if (@ViewBag.mensaje == null)
                {
                    <div class="alert alert-danger" role="alert" style="float:right">
                        @ViewBag.mensaje
                    </div>
                }
            }
            comunicate con el administrador de la plataforma
        </p>

    </center>
</div>