@model Front_TalleresSeta.Modelos.InventarioProveedor

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

    var tipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
    var tipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}

<div class="container-fluid">
    @if (ViewBag.accion == "ACTUALIZAR")
    {
        <div id="alert-message" class="alert alert-info" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ACTUALIZADO")
    {
        <div id="alert-message" class="alert alert-success" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ERROR_DATOS")
    {
        <div id="alert-message" class="alert alert-warning" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else if (ViewBag.accion == "ERROR_CATCH")
    {
        <div id="alert-message" class="alert alert-danger" role="alert">
            @ViewBag.mensaje
        </div>
    }
</div>

<div class="container-fluid">
    <div class="card shadow mb-lg-4">
        <div class="card-header py-3">
            <div class="row">
                <!-- Actualizar proveedor -->
                <div class="col-md-4">
                    <div class="form-group">
                        <span class="nav-link">
                            <i class="fab fa-wpforms"></i>
                            Actualizar proveedor
                        </span>
                    </div>
                </div>
                <!-- Texto campos obligatorios  -->
                <div class="text-right col-sm-8">
                    <div class="form-group">
                        <span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Formulario: actualizar proveedor -->
            <form class="needs-validation" novalidate asp-controller="InventarioProveedores" asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="InventarioProveedorId" />

                <div class="row mb-3">
                    <label for="validarActivo" class="col-sm-3 col-form-label">
                        ACTIVO <b style="color:red;">*</b>
                        <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Indique si el proveedor está activo"></i>
                    </label>
                    <div class="col-sm-2">
                        <input type="checkbox" class="form-check-input" id="validarActivo" asp-for="Habilitado">
                    </div>
                </div>
                <hr />

                <div class="row mb-3">
                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarRazonSocial" class="col-form-label">
                                RAZÓN SOCIAL <b style="color:red;">*</b>
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una Razón Social"></i>
                            </label>
                            <input type="text" class="form-control" id="validarRazonSocial" asp-for="RazonSocial" required>
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa una razón social valida.</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarProveedor" class="col-form-label">
                                PROVEEDOR
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa el nombre del proveedor"></i>
                            </label>
                            <input type="text" class="form-control" id="validarProveedor" asp-for="NombreProveedor" required>
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa un nombre para para el proveedor.</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarNit" class="col-form-label">
                                NIT
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa el NIT del proveedor"></i>
                            </label>
                            <input type="text" class="form-control" id="validarNit" asp-for="Nitproveedor" required>
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa un Nit o # de documento.</div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarDireccion" class="col-form-label">
                                DIRECCIÓN
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa una dirección"></i>
                            </label>
                            <input type="text" class="form-control" id="validarDireccion" asp-for="Direccion">
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa una dirección valida.</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarTelefono" class="col-form-label">
                                TELÉFONO
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un número de teléfono fijo de 7 dígitos"></i>
                            </label>
                            <input type="text" class="form-control" id="validarTelefono" asp-for="Telefono" pattern="[0-9]{7}">
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa un # de teléfono valido.</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarMovil" class="col-form-label">
                                CELULAR
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un número de celular de 10 dígitos"></i>
                            </label>
                            <input type="text" class="form-control" id="validarMovil" asp-for="Movil" pattern="[0-9]{10}">
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa un # celular valido.</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarCorreo" class="col-form-label">
                                CORREO
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa un correo válido"></i>
                            </label>
                            <input type="email" class="form-control" id="validarCorreo" asp-for="Correo">
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Ingresa un correo valido.</div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            <label for="validarUrl" class="col-form-label">
                                URL
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresa una URL o link de página del proveedor"></i>
                            </label>
                            <input type="text" class="form-control" id="validarUrl" asp-for="Url">
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">ingresa url con https://</div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-4">
                        <div class="form-group">
                            @if (tipoUser == "SuperAdmin")
                            {
                                <label for="validarTaller" class="col-form-label">
                                    Taller <b style="color:red;">*</b>
                                    <i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
                                </label>
                                <select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
                            }
                            else
                            {
                                <label for="validarTaller" class="col-form-label">
                                    Taller
                                </label>
                                <select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
                            }
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Selecciona algún Taller.</div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-lg-8 col-sm-4">
                        <div class="form-group">
                            <label for="validarDetalle" class="col-form-label">
                                DETALLE
                                <i class="far fa-question-circle" data-bs-toggle="tooltip" title="No mayor a 200 caracteres"></i>
                            </label>
                            <textarea class="form-control" id="validarDetalle" asp-for="Detalle" rows="6" maxlength="200"></textarea>
                            <div class="valid-tooltip">OK!</div>
                            <div class="invalid-tooltip">Detalle superó los 200 caracteres</div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="row">
                    <!-- Botón atrás -->
                    <div class="col-sm-6">
                        <a asp-controller="InventarioProveedores" asp-action="Details" asp-route-id="@Model.InventarioProveedorId" class="btn btn-dark">Atrás</a>
                    </div>
                    <!-- Botón Modificar -->
                    <div class="col-sm-6 text-right">
                        <input type="submit" value="Modificar" class="btn btn-primary" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Inicializar tooltips
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        // Validaciones
        (function () {
            'use strict';

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation');

            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }

                        form.classList.add('was-validated');
                    }, false);
                });
        })();

        // Ocultar el mensaje después de 30 segundos
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
