@model Front_TalleresSeta.Modelos.InventarioLote


@{
	ViewData["Title"] = "Editar";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var tipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var tipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}

<div class="container-fluid">
	@if (ViewBag.accion == "ACTUALIZAR")
	{
		<div id="alert-message" class="alert alert-info" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ACTUALIZADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ERROR_DATOS")
	{
		<div id="alert-message" class="alert alert-warning" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "ERROR_CATCH")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>


<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Actualizar Lote
						</span>
					</div>
				</div>
				<div class="text-right col-sm-8">
					<div class="form-group">
						<span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">
			<form class="needs-validation" novalidate asp-controller="InventarioLotes" asp-action="Edit">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<input type="hidden" asp-for="LoteId" />
				<input type="hidden" asp-for="CodigoProducto" />

				<div class="row">
					<div class="col-lg-6 col-sm-6">
						<div class="col-lg-6">
							<div class="form-group">
								<label for="validarLote" class="text-center col-sm-12 col-form-label">
									LOTE
								</label>
								<div class="text-center col-sm-12">
									<input type="text" class="form-control" id="validarLote" asp-for="LoteId" style="text-align: center;" disabled>
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group">
								<label for="validarCodigo" class="text-center col-sm-12 col-form-label">
									CÓDIGO PRODUCTO
								</label>
								<div class="text-center col-sm-12">
									<input type="text" class="form-control" id="validarCodigo" asp-for="CodigoProducto" style="text-align: center;" disabled>
								</div>
							</div>
						</div>
					</div>

					<div class="col-lg-2"></div>

					<div class="col-lg-4 col-sm-4">
						<div class="col-lg-12">
							<div class="form-group">
								<label for="ImagenProducto" class="col-sm-12 text-center">
									PRODUCTO
								</label>
								<div class="text-center col-sm-12">
									<input type="hidden" asp-for="InventarioEntradaProductos.ImagenProducto" id="ImagenProducto" />
									<img class="form-control" src="@ViewBag.ImagenProducto" id="previewImagenProducto" alt="Imagen del Producto Actual" style="max-width: 200px; height: 200px; border: 2px solid #ddd; padding: 5px; border-radius: 10px; margin-top: 0px; margin-left: auto; margin-right: auto; display: none;" />
									<img class="form-control" src="~/images/Admin_Productos/SinArchivos.png" id="iconoPreviewImagenProducto" alt="Imagen del producto" style="max-width: 100px; height: 100px; border: 2px solid #ddd; padding: 5px; border-radius: 10px; margin-top: 0px; margin-left: auto; margin-right: auto; display: block;" />
								</div>
							</div>
						</div>
					</div>
				</div>
				<hr />

				<div class="row">
					<div class="text-center col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarActivoLote" class="text-center col-sm-6">
								ACTIVO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Indique si el lote se encuentra activo"></i>
							</label>
							<div class="text-center col-sm-12">
								<input type="checkbox" class="form-check-label" id="validarActivoLote" asp-for="@Model.Habilitado">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarCantidadIngresan" class="col-sm-12 col-form-label">
								CANT INGRESAN <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una cantidad valida"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarCantidadIngresan" asp-for="CantIngresan" readonly required>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Ingresa una cantidad valida
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarCantidadRestante" class="col-sm-12 col-form-label">
								CANT RESTANTE <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una cantidad valida"></i>
							</label>
							<div class="col-sm-12">								
								<input type="text" class="form-control" id="validarCantidadRestante" asp-for="CantRestante" readonly required>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Ingresa una cantidad valida
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarPrecioC" class="col-sm-12 col-form-label">
								PRECIO COMPRA <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un precio de compra por unidad"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarPrecioC" name="PrecioCompraPorUni" value="@ViewBag.PrecioCompraPorUni"
									   oninput="formatoMoneda(this, 'resPrecioC')" required>
								<p id="resPrecioC"></p>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								precio compra incorrecto
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-2">
						<div class="form-group">
							<label for="validarPrecioV" class="col-sm-12 col-form-label">
								PRECIO VENTA <b style="color:red;"> *</b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un precio de venta por unidad"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarPrecioV" name="PrecioVentaPorUni" value="@ViewBag.PrecioVentaPorUni"
									   oninput="formatoMoneda(this, 'resPrecioV')" required>
								<p id="resPrecioV"></p>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								precio venta incorrecto
							</div>
						</div>
					</div>

					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							@{
								if (tipoUser == "SuperAdmin")
								{
									<label for="validarTaller" class="col-sm-12 col-form-label">
										Taller<b style="color:red;"> *</b>
										<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
									</label>
									<div class="col-sm-12">
										<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
									</div>
								}
								else
								{
									<label for="validarTaller" class="col-sm-12 col-form-label">
										Taller
									</label>
									<div class="col-sm-12">
										<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
									</div>
								}
							}
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona algún Taller.
							</div>
						</div>
					</div>
				</div>

				<hr />
				<div class="row">
					<!-- Botón atrás -->
					<div class="col-sm-6">
						<div class="form-group">
							<a asp-controller="InventarioLotes" asp-action="VerLotes" asp-route-id="@Model.CodigoProducto" class="btn btn-dark btn-regresar">Atrás</a>
						</div>
					</div>
					<!-- Botón Modificar -->
					<div class="col-sm-6">
						<div class="form-group">
							<input type="submit" value="Modificar" class="btn btn-primary btn-actualizar" />
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {

	<script src="~/js/CodigoDeBarras/EditarLote.js"></script>

	<script>
		// Inicializar tooltips
		$(function () {
			$('[data-bs-toggle="tooltip"]').tooltip();
		});

		// Validaciones
		(function () {
			'use strict'

			// Fetch all the forms we want to apply custom Bootstrap validation styles to
			var forms = document.querySelectorAll('.needs-validation')

			// Loop over them and prevent submission
			Array.prototype.slice.call(forms)
				.forEach(function (form) {
					form.addEventListener('submit', function (event) {
						if (!form.checkValidity()) {
							event.preventDefault()
							event.stopPropagation()
						}

						form.classList.add('was-validated')
					}, false)
				})
		})()

		// Ocultar el mensaje
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos


		function formatoMoneda(input, resultPrecio) {
			const resultadoElement = document.getElementById(resultPrecio);

			// Obtener el valor actual del input y remover los caracteres no numéricos
			let precio = input.value.replace(/\D/g, '');
			//let amount = precio.replace(',', '.');
			let amount = parseInt(precio);

			if (!isNaN(amount)) {
				// Formatear el valor como moneda COP
				const formatoMoneda = new Intl.NumberFormat("es-CO", {
					style: "currency",
					currency: "COP",
					minimumFractionDigits: 0,
					maximumFractionDigits: 0
				});
				const cantidadFormateada = formatoMoneda.format(amount);
				input.value = cantidadFormateada;
			} else {
					input.value = '';
				resultadoElement.textContent = "Por favor ingrese un valor válido.";
			}
		}

	</script>


	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}