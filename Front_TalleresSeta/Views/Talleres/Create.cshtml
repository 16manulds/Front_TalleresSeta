@model Front_TalleresSeta.Modelos.Taller


@{
	ViewData["Title"] = "Create";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var TipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var TipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
	@if (ViewBag.accion == "CREADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "FALLO")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "CREADO_CON_ERROR")
	{
		<div id="alert-message" class="alert alert-warning" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>


<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Registrar Taller
						</span>
					</div>
				</div>
				<div class="text-right col-sm-8">
					<div class="form-group">
						<span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">
			<form class="needs-validation" novalidate asp-controller="Talleres" asp-action="Create">

				<div class="row">
					<div class="text-center col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarActivoTaller" class="text-center col-sm-6">
								ACTIVO
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Indique si el Taller se encuentra activo"></i>
							</label>
							<div class="text-center col-sm-12">
								<input type="checkbox" class="form-check-label" id="validarActivoTaller" asp-for="Habilitado">
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarNit" class="col-sm-12 col-form-label">
								NIT<b style="color:red;">* </b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una posición del Taller en el vehículo"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarNit" asp-for="NitTaller" required>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-12">
						<div class="form-group">
							<label for="validarRazonSocial" class="col-sm-12 col-form-label">
								RAZÓN SOCIAL<b style="color:red;">* </b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar una razón social para el Taller"></i>
							</label>
							<div class="col-sm-12">
								<input type="text" class="form-control" id="validarRazonSocial" asp-for="RazonSocialTaller" required>
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-lg-4 col-sm-12">
						<div class="form-group">
							<label class="col-sm-12 col-form-label">
								FECHA FUNDACIÓN<b style="color:red;">* </b>
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona una fecha de fundación"></i>
							</label>
							<div class="col-sm-12">
								<input type="date" class="form-control" id="validarFechaFundacion" asp-for="FechaFundacion" required>
							</div>
						</div>
					</div>					
				</div>

				<div class="row">
					<div class="col-lg-8 col-sm-12">
						<div class="form-group">
							<label for="validarDetalle" class="col-sm-12 col-form-label">
								DETALLE
								<i class="far fa-question-circle" data-bs-toggle="tooltip" title="No mayor a 300 caracteres"></i>
							</label>
							<div class="col-sm-12">
								<textarea type="text" class="form-control" id="validarDetalle" asp-for="Detalle"
										  rows="10" cols="50"></textarea>
							</div>
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								detalle superó los 300 caracteres
							</div>
						</div>
					</div>
				</div>

				<hr />
				<div class="row">
					<!-- Botón atrás -->
					<div class="col-sm-6">
						<div class="form-group">
							<a asp-controller="Talleres" asp-action="Index" class="btn btn-dark btn-regresar">Atrás </a>
						</div>
					</div>
					<!-- Botón registrar -->
					<div class="col-sm-6">
						<div class="form-group">
							<input type="submit" value="Registrar" class="btn btn-success btn-registrar" />
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {

	<script>

		// Validaciones
		(function () {
			'use strict'

			// Fetch all the forms we want to apply custom Bootstrap validation styles to
			var forms = document.querySelectorAll('.needs-validation')

			// Loop over them and prevent submission
			Array.prototype.slice.call(forms)
				.forEach(function (form) {
					form.addEventListener('submit', function (event) {
						if (!form.checkValidity()) {
							event.preventDefault()
							event.stopPropagation()
						}

						form.classList.add('was-validated')
					}, false)
				})
		})()

		// Ocultar el mensaje después de 30 segundos
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

	</script>


	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}