@model Front_TalleresSeta.Modelos.TipoDocumento

@{
	ViewData["Title"] = "Create";
	Layout = "~/Views/Shared/Interfaz/_LayoutVerticalInterfaz.cshtml";

	var TipoUser = User.FindFirst("TipoUsuarioAcceso")?.Value ?? string.Empty;
	var TipoRol = User.FindFirst("TipoRolAcceso")?.Value ?? string.Empty;
}


<div class="container-fluid">
	@if (ViewBag.accion == "CREADO")
	{
		<div id="alert-message" class="alert alert-success" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "FALLO")
	{
		<div id="alert-message" class="alert alert-danger" role="alert">
			@ViewBag.mensaje
		</div>
	}
	else if (ViewBag.accion == "CREADO_CON_ERROR")
	{
		<div id="alert-message" class="alert alert-warning" role="alert">
			@ViewBag.mensaje
		</div>
	}
</div>


<div class="container-fluid">
	<div class="card shadow mb-lg-4">
		<div class="card-header py-3">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<span class="nav-link">
							<i class="fab fa-wpforms"></i>
							Registrar tipo de documento
						</span>
					</div>
				</div>
				<div class="text-right col-sm-8">
					<div class="form-group">
						<span style="float:right;">Campos Obligatorios <b style="color:red;">*</b></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">
			<form class="needs-validation" novalidate asp-controller="TipoDocumentos" asp-action="Create">
				<div class="row">
					<div class="col-lg-4 col-md-4">
						<div class="row">
							<div class="col-lg-12 col-md-12">
								<div class="form-group">
									<label for="validarTipoDocumento" class="col-sm-12 col-form-label">
										TIPO DOCUMENTO<b style="color:red;"> *</b>
										<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un tipo de documento"></i>
									</label>
									<div class="col-sm-12">
										<input type="text" class="form-control text-center" id="validarTipoDocumento" asp-for="TipoD" placeholder="TI, CE, CC, PP, NIT..." required>
										<div class="valid-tooltip">
											OK!
										</div>
										<div class="invalid-tooltip">
											tipo de documento incorrecto
										</div>
									</div>
								</div>
							</div>
						</div>						
					</div>		
					<div class="col-lg-4 col-md-4">
						<div class="row">
							<div class="col-lg-12 col-md-12">
								<div class="form-group">
									<label for="validarNombreTipoDocumento" class="col-sm-12 col-form-label">
										NOMBRE TIPO DOCUMENTO<b style="color:red;"> *</b>
										<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Ingresar un nombre para el tipo de documento a crear"></i>
									</label>
									<div class="col-sm-12">
										<input type="text" class="form-control text-center" id="validarNombreTipoDocumento" asp-for="NombreDocumento" placeholder="Cedula, Pasaporte, Nit..." required>
										<div class="valid-tooltip">
											OK!
										</div>
										<div class="invalid-tooltip">
											Nombre de tipo documento incorrecto
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<hr class="my-4" />							
								
				<div class="row">
					<div class="col-lg-3 col-sm-4">
						<div class="form-group">
							@if (TipoUser == "SuperAdmin")
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller<b style="color:red;"> *</b>
									<i class="far fa-question-circle" data-bs-toggle="tooltip" title="Selecciona un Taller"></i>
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							else
							{
								<label for="validarTaller" class="col-sm-12 col-form-label">
									Taller
								</label>
								<div class="col-sm-12">
									<select asp-for="TallerId" class="form-control" asp-items="ViewBag.TallerId"></select>
								</div>
							}
							<div class="valid-tooltip">
								OK!
							</div>
							<div class="invalid-tooltip">
								Selecciona algún Taller.
							</div>
						</div>
					</div>
				</div>
								
				<hr />
				<div class="row">
					<!-- Botón atrás -->
					<div class="col-sm-6">
						<div class="form-group">
							<a asp-controller="TipoDocumentos" asp-action="Index" class="btn btn-dark btn-regresar">Atrás </a>
						</div>
					</div>
					<!-- Botón registrar -->
					<div class="col-sm-6">
						<div class="form-group">
							<input type="submit" value="Registrar" class="btn btn-success btn-registrar" />
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {
		
	<script>
				
		// Validaciones
		(function () {
			'use strict'

			// Fetch all the forms we want to apply custom Bootstrap validation styles to
			var forms = document.querySelectorAll('.needs-validation')

			// Loop over them and prevent submission
			Array.prototype.slice.call(forms)
				.forEach(function (form) {
					form.addEventListener('submit', function (event) {
						if (!form.checkValidity()) {
							event.preventDefault()
							event.stopPropagation()
						}

						form.classList.add('was-validated')
					}, false)
				})
		})()

				
		// Ocultar el mensaje después de 30 segundos
		setTimeout(function () {
			var alertMessage = document.getElementById("alert-message");
			if (alertMessage) {
				alertMessage.style.display = "none";
			}
		}, 30000); // 30 segundos

	</script>


	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}